{
  "name": "catmap-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run fetch-model && vite build",
    "build:mobile": "npm run fetch-model && vite build --mode mobile",
    "build:mobile:clean": "bash scripts/build-mobile.sh",
    "fetch-model": "node scripts/fetch-model.mjs",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "cap:sync": "npm run build:mobile:clean",
    "cap:open": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:assets": "npm run generate:icons && node node_modules/@capacitor/assets/bin/capacitor-assets generate --android",
    "android:debug": "bash scripts/build-android-debug.sh",
    "android:release": "bash scripts/build-android-release.sh",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.4",
    "@capacitor/core": "^7.6.7",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@sentry/react": "^10.63.0",
    "browser-image-compression": "^2.0.2",
    "exifr": "^7.1.3",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.5.6",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.7",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
