{
  "name": "catmap-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "npm run fetch-model && vite build",
    "build:mobile": "npm run fetch-model && vite build --mode mobile",
    "build:mobile:clean": "bash scripts/build-mobile.sh",
    "fetch-model": "node scripts/fetch-model.mjs",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "cap:sync": "npm run build:mobile:clean",
    "cap:open": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:open:ios": "node node_modules/@capacitor/cli/bin/capacitor open ios",
    "cap:assets": "npm run generate:icons && node node_modules/@capacitor/assets/bin/capacitor-assets generate --android --ios",
    "android:debug": "bash scripts/build-android-debug.sh",
    "android:release": "bash scripts/build-android-release.sh",
    "ios:archive": "bash scripts/build-ios-archive.sh",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "8.5.0",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/ios": "8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@sentry/react": "^10.70.0",
    "browser-image-compression": "^2.0.2",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "onnxruntime-web": "^1.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
