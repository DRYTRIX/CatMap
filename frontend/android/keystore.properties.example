# Copy to keystore.properties and fill in values before release builds.
# Generate a keystore:
#   keytool -genkey -v -keystore catmap-upload.keystore -alias catmap \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=../catmap-upload.keystore
storePassword=CHANGE_ME
keyAlias=catmap
keyPassword=CHANGE_ME
